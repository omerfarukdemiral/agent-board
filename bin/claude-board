#!/bin/sh
# claude + agent-board: hooks (plugin), the agent-board channel (board → Claude messages) and the dev-channel flag.
# Every argument is passed through to claude, e.g. `claude-board --resume`.
# The dev-channel flag shows a one-time warning screen per launch; press Enter to continue.
SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
# the board's flow view is built from the task list; newer models only get the task tools on opt-in
export CLAUDE_CODE_ENABLE_TODO_TOOLS="${CLAUDE_CODE_ENABLE_TODO_TOOLS:-1}"
AB=$(cd "$(dirname "$SELF")/.." && pwd)
exec claude \
  --plugin-dir "$AB" \
  --mcp-config "{\"mcpServers\":{\"agent-board\":{\"command\":\"node\",\"args\":[\"$AB/channel/server.js\"]}}}" \
  --dangerously-load-development-channels server:agent-board \
  "$@"
